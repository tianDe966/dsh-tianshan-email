{
  "name": "dsh-tianshan-email",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin: a self-hosted SMTP mail plugin. Gives the agent a send_mail tool so it can report progress and deliver results to your inbox while you are away, plus a settings card of its own (SMTP server/port/TLS/sender/auth-code/recipient and a test-mail button; the auth code is a secret field, redacted in the browser).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "test:sandbox": "node --test --test-isolation=none",
    "prepublishOnly": "node build.mjs && npm run test:sandbox"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "email",
    "smtp",
    "mail"
  ],
  "author": "tianshan123 <326958984+tianDe966@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
